{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Availability SLO (99.9% target)",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 100,
      "collapsed": false
    },
    {
      "title": "Availability (30d rolling)",
      "type": "gauge",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "id": 1,
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.99,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.999
              },
              {
                "color": "green",
                "value": 0.9995
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "1 - (\n  sum(rate(ray_serve_num_deployment_http_error_requests_total[30d]))\n  /\n  clamp_min(sum(rate(ray_serve_deployment_request_counter_total[30d])), 1)\n)",
          "legendFormat": "Availability",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "title": "Error Budget Remaining (30d window)",
      "type": "stat",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "1 - (\n  sum(rate(ray_serve_num_deployment_http_error_requests_total[30d]))\n  /\n  clamp_min(sum(rate(ray_serve_deployment_request_counter_total[30d])), 1)\n  / 0.001\n)",
          "legendFormat": "Budget Remaining",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "title": "Error Budget Burn Rate (1h vs 6h)",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "(\n  sum(rate(ray_serve_num_deployment_http_error_requests_total[1h]))\n  /\n  clamp_min(sum(rate(ray_serve_deployment_request_counter_total[1h])), 1)\n) / 0.001",
          "legendFormat": "1h burn rate",
          "refId": "A"
        },
        {
          "expr": "(\n  sum(rate(ray_serve_num_deployment_http_error_requests_total[6h]))\n  /\n  clamp_min(sum(rate(ray_serve_deployment_request_counter_total[6h])), 1)\n) / 0.001",
          "legendFormat": "6h burn rate",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Latency SLO Compliance",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "id": 101,
      "collapsed": false
    },
    {
      "title": "TTFT P95 vs SLO (5s)",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "id": 4,
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "ray_vllm:ttft_p95:5m{model_name=~\"$model\"}",
          "legendFormat": "{{model_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "TPOT P95 vs SLO (200ms)",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "id": 5,
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "ray_vllm:tpot_p95:5m{model_name=~\"$model\"}",
          "legendFormat": "{{model_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "E2E Latency P95 vs SLO (30s)",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "id": 6,
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ray_vllm_e2e_request_latency_seconds_bucket{model_name=~\"$model\"}[5m])) by (le, model_name))",
          "legendFormat": "{{model_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Throughput & Capacity",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "id": 102,
      "collapsed": false
    },
    {
      "title": "Token Throughput",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "id": 7,
      "fieldConfig": {
        "defaults": {
          "unit": "tok/s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "ray_vllm:throughput_tokens_per_sec:5m{model_name=~\"$model\"}",
          "legendFormat": "{{model_name}} generation",
          "refId": "A"
        },
        {
          "expr": "sum(rate(ray_vllm_prompt_tokens_total{model_name=~\"$model\"}[5m])) by (model_name)",
          "legendFormat": "{{model_name}} prompt",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Active Replicas vs Capacity",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "id": 8,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "ray_serve_deployment_replica_healthy",
          "legendFormat": "{{deployment}} healthy",
          "refId": "A"
        },
        {
          "expr": "ray_serve_deployment_queued_queries",
          "legendFormat": "{{deployment}} queued",
          "refId": "B"
        },
        {
          "expr": "ray_serve_replica_processing_queries",
          "legendFormat": "{{deployment}} processing",
          "refId": "C"
        }
      ]
    },
    {
      "title": "Prefix Cache Hit Rate",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "id": 9,
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "ray_vllm:prefix_cache_hit_rate:5m{model_name=~\"$model\"}",
          "legendFormat": "{{model_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Error Rate",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "id": 10,
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(ray_serve_num_deployment_http_error_requests_total[5m])) by (deployment) / clamp_min(sum(rate(ray_serve_deployment_request_counter_total[5m])) by (deployment), 1)",
          "legendFormat": "{{deployment}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 103,
      "type": "row",
      "title": "Synthetic Probe",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Probe success rate (1h rolling)",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "avg_over_time(openserve_probe_success[1h])",
          "legendFormat": "{{model}} / {{endpoint}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Probe P95 latency (per model, per endpoint)",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 8,
        "y": 36,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(openserve_probe_latency_seconds_bucket[10m])) by (le, model, endpoint))",
          "legendFormat": "{{model}} / {{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Time since last success",
      "description": "How long ago each model/endpoint last reported a successful probe. Stale values indicate the probe is failing for that target.",
      "datasource": "${datasource}",
      "gridPos": {
        "x": 16,
        "y": 36,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1800
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "time() - max by (model, endpoint) (openserve_probe_last_success_timestamp)",
          "legendFormat": "{{model}} / {{endpoint}}",
          "refId": "A",
          "instant": true
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "model",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(ray_vllm_request_success_total, model_name)",
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "multi": true,
        "hide": 0,
        "refresh": 2,
        "sort": 1,
        "label": "Model"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Ray Serve - SLO Tracking",
  "uid": "ray-serve-slo-tracking",
  "version": 1
}