            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum(rate(ray_vllm_e2e_request_latency_seconds_bucket{model_name=~\"$model\"}[5m])) by (le, model_name))",
                    "legendFormat": "{{model_name}}",
                    "refId": "A"
