            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": [
                        "lastNotNull",
                        "mean",
                        "max"
                    ]
                },
                "tooltip": {
                    "mode": "multi"
                }
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum(rate(ray_vllm_request_time_per_output_token_seconds_bucket{model_name=~\"$model\"}[5m])) by (le, model_name))",
                    "legendFormat": "{{model_name}}",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "P95 End-to-End Latency",
