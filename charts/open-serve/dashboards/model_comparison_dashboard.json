        {
            "title": "Throughput",
            "type": "row",
            "gridPos": {
                "x": 0,
                "y": 9,
                "w": 24,
                "h": 1
            },
            "id": 101,
            "collapsed": false
        },
        {
            "title": "Generation Tokens/sec",
            "type": "timeseries",
            "datasource": "${datasource}",
            "gridPos": {
                "x": 0,
                "y": 10,
                "w": 8,
                "h": 8
            },
            "id": 4,
            "fieldConfig": {
                "defaults": {
                    "unit": "tok/s",
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "gradientMode": "none",
                        "showPoints": "never"
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "calcs": [
                        "lastNotNull",
